<div class="news">
  {% if site.news != blank %}
    {% assign news = site.news | reverse %}
    {% assign news_size = site.news | size %}

    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% if include.limit %}
          {% assign visible_news = 3 %}
        {% else %}
          {% assign visible_news = news_size %}
        {% endif %}

        {% for item in news limit: visible_news %}
          <tr>
            <th scope="row" style="width: 20%">
              {{ item.date | date: '%b %d, %Y' }}
            </th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">
                  {{ item.title }}
                </a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>

    {% if include.limit and news_size > 3 %}
      <details class="older-news">
        <summary>Older news</summary>

        <div class="table-responsive mt-2">
          <table class="table table-sm table-borderless">
            {% for item in news offset: 3 %}
              <tr>
                <th scope="row" style="width: 20%">
                  {{ item.date | date: '%b %d, %Y' }}
                </th>
                <td>
                  {% if item.inline %}
                    {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                  {% else %}
                    <a class="news-title" href="{{ item.url | relative_url }}">
                      {{ item.title }}
                    </a>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </table>
        </div>
      </details>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
